# Copy this file to `.env` and fill in your keys. `.env` is git-ignored.
# Load it into your shell, or the app will read it automatically on startup.

# Tier 1 — the brain (required)
ANTHROPIC_API_KEY=

# Tier 3 — the ears and mouth (only needed once you add voice)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
